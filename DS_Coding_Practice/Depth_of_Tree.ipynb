   "source": [
    "class Solution:\n",
    "    def maxDepth(self, root: Optional[TreeNode]) -> int:\n",
    "\n",
    "        if root is None:\n",
    "            return 0\n",
    "        \n",
    "        return 1+ max(self.maxDepth(root.left), self.maxDepth(root.right))"
   ]
  }
 ],
